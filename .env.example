# Contoh konfigurasi environment — epicRider (Phase 3)
# Salin file ini ke `.env` lalu isi dengan nilai nyata. JANGAN commit `.env` (sudah di-ignore).
# Jangan pernah menyalin nilai rahasia/nyata ke dalam file ini.

# DATABASE_URL — koneksi database yang dipakai Prisma (SQLite di pengembangan lokal).
# Format: "file:<path-relatif-terhadap-folder-prisma>"
# Placeholder di bawah hanya contoh untuk pengembangan lokal; database produksi = keputusan OD-01 (belum ditentukan).
DATABASE_URL="file:./dev.db"
