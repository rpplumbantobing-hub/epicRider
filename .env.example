# Contoh konfigurasi environment — epicRider (Phase 4).
# Salin file ini ke `.env` lalu isi dengan nilai nyata. JANGAN commit `.env` (sudah di-ignore).
# Jangan pernah menyalin nilai rahasia/nyata ke dalam file ini.

# DATABASE_URL — koneksi database yang dipakai Prisma (SQLite di pengembangan lokal).
# Format: "file:<path-relatif-terhadap-folder-prisma>"
# Placeholder di bawah hanya contoh untuk pengembangan lokal; database produksi = keputusan OD-01 (belum ditentukan).
DATABASE_URL="file:./dev.db"

# NEXTAUTH_SECRET — secret penandatanganan cookie/CSRF next-auth v4 (WAJIB di produksi).
# Bangun dengan: openssl rand -base64 32
# Tanpa nilai ini di produksi, autentikasi gagal aman (fail-safe) — tidak ada mode palsu.
NEXTAUTH_SECRET=""

# NEXTAUTH_URL — URL dasar aplikasi (contoh pengembangan lokal; sesuaikan deployment).
NEXTAUTH_URL="http://localhost:3000"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — kredensial Google OIDC (OAuth 2.0).
# Kosong = provider Google tidak aktif: UI menampilkan status aman "belum dikonfigurasi"
# (tidak ada login palsu). JANGAN menaruh nilai rahasia nyata di file ini.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Parameter PROPOSED (OD-115/OD-03; override opsional, nilai default terpusat
# --- di src/lib/config/security-config.ts — BUKAN keputusan owner final) ---
# SESSION_MAX_AGE_SECONDS="604800"   # umur sesi (default PROPOSED 7 hari)
# INVITATION_EXPIRY_DAYS="7"         # masa berlaku undangan (PROPOSED)
# OTP_MAX_ATTEMPTS="5"               # percobaan verifikasi OTP maksimum (PROPOSED)
