// epicRider — Prisma schema, Phase 4 (Identity, Authentication, Session,
// Workspace/Tenant, Membership, Invitation, Roles & Permissions).
//
// Sumber model: `DATA_MODEL_CONCEPT.md` §3.1 (Identity), §3.2 (Workspace/Tenant),
// §3.3 (Membership & Roles), §3.14 (Audit) — status PROPOSED pada dokumen model;
// implementasi ini adalah realisasi Phase 4 pertama sesuai ADR-008/009/010.
//
// Catatan keputusan (lihat `PHASE_4_IMPLEMENTATION_PLAN.md` §6):
// - Demo model scaffold `User`(email non-null)/`Post` diganti model domain epicRider
//   (gated prompt §5.1: email bukan kunci utama; Post bukan entitas epicRider).
// - `next-auth` v4 (database session strategy) memakai `Account`+`Session` di bawah
//   melalui adapter custom (`src/lib/auth/adapter.ts`).
// - Uniqueness "live membership" ditegakkan lewat partial unique index pada SQL
//   migrasi (SQLite): UNIQUE(workspace_id, user_id) WHERE status live — histori
//   baris lama tetap terjaga (DMC §3.3).
// - Runtime lisensi/entitlement penuh (evaluasi engine, issuance, checkout)
//   TETAP tidak dimodelkan di sini (Phase 5-C/D/E) — tanpa mengarang license
//   state final, tanpa harga/komersial (OD-06), tanpa durasi (OD-108).
// - Phase 5-B (2026-10-30, branch integration/phase5-b-licensing-domain-db)
//   menambahkan FONDASI domain/database licensing (DMC §3.5/§3.6/§6.2/§8;
//   REQ-002/018/024/026/029/098/099): LicenseTier, License, Capability,
//   CapabilityRule, ExtensionType, ExtensionDefinition, ExtensionInstance,
//   TierQuota — struktur data SAJA. Detail keputusan: PHASE_5_REPORT.md dan
//   adr/ADR-023-phase5b-licensing-domain-foundation.md (PROPOSED).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== Identity context (DMC §3.1) =====================

/// Identitas global user — BUKAN membership, BUKAN role (REQ-025).
/// Email bukan kunci utama; nullable karena kanal WhatsApp tidak wajib punya email.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  status        String    @default("ACTIVE") // ACTIVE | DEACTIVATED | ANONYMIZED (PROPOSED; mekanika = OD-09)
  locale        String? // preferensi locale user (REQ-028; default platform = OD-12)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  memberships    Membership[]
  developerRoles DeveloperRoleAssignment[]
  auditEvents    AuditEvent[]

  @@index([status])
}

/// Kanal login terverifikasi (= DMC `AuthenticationMethod`): akun Google OIDC,
/// nomor WhatsApp terverifikasi, dsb. Linking aman = lewat kebijakan no-auto-link
/// (REQ-022/REQ-047; ADR-022).
model Account {
  id                String    @id @default(cuid())
  userId            String
  type              String
  provider          String // "google" | "whatsapp" (kanal; vendor WhatsApp = OD-03 OPEN)
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         DateTime?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  linkedAt          DateTime  @default(now())
  unlinkedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Sesi aktif terautentikasi (REQ-048; next-auth database strategy).
/// RevokedAt non-null => sesi ditolak pada request berikutnya (REQ-048 acceptance).
model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  deviceLabel  String?
  userAgent    String?
  createdAt    DateTime  @default(now())
  expires      DateTime
  revokedAt    DateTime?
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// Challenge OTP sekali pakai untuk proof-of-control nomor WhatsApp (REQ-021; ADR-009).
/// Hanya hash kode yang disimpan — kode mentah TIDAK pernah disimpan/di-log.
/// Vendor pengiriman = OD-03 OPEN (interface `OtpDeliveryProvider`).
model VerificationRequest {
  id            String    @id @default(cuid())
  channel       String    @default("WHATSAPP")
  target        String // nomor telepon format E.164
  tokenHash     String    @unique // SHA-256 kode OTP
  status        String    @default("PENDING") // PENDING | CONSUMED | EXPIRED | BLOCKED
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(5) // PROPOSED (security-config)
  expiresAt     DateTime
  usedAt        DateTime?
  lastAttemptAt DateTime?
  blockedUntil  DateTime?
  createdAt     DateTime  @default(now())

  @@index([target, status, createdAt])
  @@index([status, expiresAt])
}

/// Role developer platform (portal/store) — TIDAK membawa permission workspace
/// dan sebaliknya (REQ-052; AUTHORIZATION_MODEL §5.3; katalog detail = OD-101).
model DeveloperRoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  role      String    @default("DEVELOPER")
  scope     String    @default("PORTAL")
  grantedBy String?
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// ===================== Workspace/Tenant context (DMC §3.2) =====================

/// Akar tenant — pemilik membership, event, aset, dokumen (REQ-023).
model Workspace {
  id              String   @id @default(cuid())
  name            String
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | ARCHIVED (PROPOSED)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships        Membership[]
  roles              Role[]
  invitations        Invitation[]
  licenses           License[] // Phase 5-B: lisensi yang dipegang tenant (DMC §3.5; onDelete Restrict — histori tidak terhapus cascade)
  extensionInstances ExtensionInstance[] // Phase 5-B: extension terprovisi pada tenant (DMC §3.6)

  @@index([status])
}

// ===================== Membership & Roles context (DMC §3.3) =====================

/// Membership satu user di satu workspace — BUKAN user, BUKAN role, BUKAN
/// assignment (REQ-025/REQ-049). Setiap transisi status mengubah akses efektif
/// seketika (policy layer membaca status terkini per request).
model Membership {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  status      String   @default("ACTIVE") // INVITED | ACTIVE | SUSPENDED | REMOVED | LEFT (REQ-049)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles       MembershipRoleAssignment[]
  invitations Invitation[]

  @@index([workspaceId, status])
  @@index([userId, status])
}

/// Role workspace-scoped. Preset minimum Phase 4: `owner` + `member`
/// (PROPOSED — katalog final per tier = OD-122 OPEN; tanpa role editor dinamis).
model Role {
  id          String   @id @default(cuid())
  workspaceId String
  key         String // "owner" | "member"
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments MembershipRoleAssignment[]
  invitations Invitation[]

  @@unique([workspaceId, key])
}

/// Role mana yang dipegang membership mana (satu user boleh beda role di
/// workspace berbeda tanpa konflik — REQ-025).
model MembershipRoleAssignment {
  id           String    @id @default(cuid())
  membershipId String
  roleId       String
  grantedBy    String?
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([membershipId, revokedAt])
}

/// Undangan aman (REQ-051): token acak kriptografis (32 byte) — hanya hash yang
/// disimpan; workspace + role yang ditawarkan terikat server-side; kedaluwarsa &
/// pencabutan; konsumsi satu kali atomik.
model Invitation {
  id            String    @id @default(cuid())
  workspaceId   String
  roleId        String
  contactTarget String // email tujuan (kanal terhubung Phase 4: Google OIDC)
  tokenHash     String    @unique // SHA-256 token 32-byte
  status        String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  acceptedAt    DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role        @relation(fields: [roleId], references: [id])
  createdBy Membership? @relation(fields: [createdById], references: [id])

  @@index([workspaceId, status])
  @@index([contactTarget, status])
}

// ===================== Audit context (DMC §3.14) =====================

/// Audit/security event — WHO/WHAT/WHEN/decision/reason + tenant. Denial adalah
/// event first-class (REQ-010/REQ-024). TANPA token/OTP/cookie/secret di payload
/// (REQ-054; `audit-service` menolak kunci metadata yang mencurigakan).
/// tenantWorkspaceId sengaja TIDAK ber-FK agar audit tetap hidup meski tenant
/// dihapus; actorUserId SetNull agar event tetap ada meski user dihapus.
model AuditEvent {
  id                String   @id @default(cuid())
  occurredAt        DateTime @default(now())
  category          String // AUTH | SESSION | WORKSPACE | MEMBERSHIP | INVITATION | AUTHZ | ABUSE
  action            String // mis. "auth.login.success" | "authz.denied" | "membership.removed"
  outcome           String // SUCCESS | DENIED | FAILURE
  actorUserId       String?
  tenantWorkspaceId String?
  targetType        String?
  targetId          String?
  reasonCode        String? // vocabulary AUTHORIZATION_MODEL §3
  metadataJson      String? // ringkas + ter-redaksi
  userAgent         String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([tenantWorkspaceId, category, occurredAt])
  @@index([category, action, outcome])
}

// ============== Licensing & Entitlement foundation (DMC §3.5/§3.6) ==============
// Phase 5-B — fondasi domain/database licensing. Sumber kontrak: DMC §3.5/§3.6/
// §6.2/§8, ENTITLEMENT_MODEL.md §2/§4/§7, LICENSE_MATRIX.md §1/§2/§5, MC §2.
// Fondasi struktur data SAJA: tanpa evaluasi engine (5-C), tanpa issuance/
// checkout (5-D/E), tanpa harga (OD-06), tanpa durasi/expiry/grace (OD-108),
// tanpa final seat counting (OD-05). License key TIDAK dimodelkan — tidak ada
// dasar kontrak (ENTITLEMENT_MODEL.md tidak mendefinisikan license key; lihat
// PHASE_5_REPORT.md §D). EntitlementGrant + Seat = runtime 5-C (DMC §3.5/§3.3),
// sengaja belum dimodelkan agar tidak mengarang mekanika enforcement.
//
// Kode status/tier/extension disimpan sebagai kode language-neutral (DMC §2.9),
// mengikuti pola Phase 4 (String + vocabulary, bukan enum Prisma — datasource
// SQLite; vocabulary divalidasi test + lapisan domain `src/lib/licensing/`).
// Satu-satunya penegakan DB-level adalah CHECK pada LicenseTier.code: himpunan
// tiga tier adalah keputusan owner yang SUDAH ditetapkan (MC §2.1, DMC §4.4) —
// berbeda dengan vocabulary status yang masih PROPOSED (tidak dikunci DB).

/// Tiga license tier resmi (MC §2.1; DMC §4.4) — closed set. hiRider BUKAN tier
/// (portal/capability); tier keempat ditolak DB-level via CHECK constraint pada
/// migration dan divalidasi test (TESTING.md: `hiRider != LicenseTier`).
model LicenseTier {
  id        String   @id @default(cuid())
  code      String   @unique // MINI_RIDER | MAX_RIDER | ISO_RIDER (closed; MC §2.1)
  isActive  Boolean  @default(true) // status aktif/nonaktif dapat dikelola (prompt §5.1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses        License[]
  tierQuotas      TierQuota[]
  capabilityRules CapabilityRule[]
}

/// Lisensi tier yang dipegang workspace (tenant) — DMC §3.5. Histori = baris
/// append-only (tanpa unique(workspaceId)); aturan kanonik "tepat satu lisensi
/// ACTIVE per workspace" (ENTITLEMENT_MODEL §2) ditegakkan partial unique index
/// pada migration (preseden Membership live-key Phase 4). purchasedAt/window
/// hanya struktur — diisi tahap issuance (5-D), durasi = OD-108 OPEN.
model License {
  id                    String    @id @default(cuid())
  workspaceId           String
  tierId                String
  status                String    @default("PURCHASED") // PURCHASED | ACTIVE | RENEWAL_DUE | EXPIRED | GRACE | DOWNGRADED (DMC §6.2; REQ-098)
  purchasedAt           DateTime? // tidak diisi otomatis di 5-B (issuance = tahap berikutnya; OD-06)
  termStartsAt          DateTime?
  termEndsAt            DateTime?
  renewalWindowStartsAt DateTime?
  graceEndsAt           DateTime?
  sourceType            String? // referensi sumber pemberian (mis. "SHOP_ORDER") — tidak diisi di 5-B
  sourceRef             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict) // REQ-099/DMC §2.3: histori lisensi tidak boleh terhapus cascade
  tier      LicenseTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status]) // resolusi lisensi efektif (DMC §3.5 access pattern)
  @@index([tierId])
  @@index([status, termEndsAt]) // sweep renewal (5-C)
}

/// Definisi capability domain (DMC §3.5) — katalog referensi GLOBAL (bukan
/// tenant-scoped). Daftar capability mengikuti LICENSE_MATRIX §2 (tidak mengarang
/// capability baru); deskripsi = i18n key (DMC §2.9), bukan string tampilan.
model Capability {
  id             String   @id @default(cuid())
  code           String   @unique
  descriptionKey String? // kunci i18n (mis. "licensing.capability.crm") — string tampilan di locale files saat UI ada
  status         String   @default("ACTIVE") // ACTIVE | DEPRECATED (DMC §3.5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rules CapabilityRule[]
}

/// Aturan ketersediaan capability (DMC §3.5) — Phase 5-B hanya memodelkan aturan
/// inklusi tier (LICENSE_MATRIX §2). Kondisi extension/role/context/object-state
/// = input engine evaluasi Phase 5-C; TIDAK dikarang sekarang (tierId nullable
/// sesuai bentuk DMC, tanpa baris non-tier di 5-B).
model CapabilityRule {
  id           String   @id @default(cuid())
  capabilityId String
  tierId       String? // null = rule non-tier (belum dipakai di 5-B; bentuk sesuai DMC §3.5)
  status       String   @default("ACTIVE") // ACTIVE | SUPERSEDED (DMC §3.5)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  capability Capability   @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  tier       LicenseTier? @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([capabilityId, tierId])
  @@index([capabilityId, status])
}

/// Jenis extension — daftar tertutup milik owner (MC §2/§3; REQ-018; DMC §3.6).
/// Penambahan jenis baru = keputusan owner, bukan data runtime.
model ExtensionType {
  id        String   @id @default(cuid())
  code      String   @unique // additional_workspace | seat_package | workspace_landing | mobile_client
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definitions ExtensionDefinition[]
}

/// Definisi katalog extension (GLOBAL; DMC §3.6) — struktur SAJA. Tidak ada
/// definisi produk yang di-seed di 5-B: tidak ada harga/ketersediaan (OD-06);
/// definisi belum disetujui tidak pernah aktif secara default.
model ExtensionDefinition {
  id          String   @id @default(cuid())
  code        String   @unique
  typeId      String
  description String?
  isActive    Boolean  @default(false) // tidak aktif sampai disetujui owner (OD-06; prompt §5.5)
  status      String   @default("CATALOG") // CATALOG (published) | WITHDRAWN (PROPOSED; DMC §3.6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type      ExtensionType       @relation(fields: [typeId], references: [id], onDelete: Restrict)
  instances ExtensionInstance[]

  @@index([typeId, isActive])
}

/// Instance extension terprovisi pada workspace (tenant-scoped; DMC §3.6) —
/// lifecycle kanonik LICENSE_MATRIX §5. Extension menambah kapasitas DI ATAS
/// tier; tidak pernah mengubah nilai tier dan bukan tier keempat (MC §2);
/// kaitan ke workspace/lisensi sesuai domain contract (DMC §3.6/§7).
///
/// Phase 5-D (ADR-025): kolom denormalisasi `typeId` (salinan
/// `definition.typeId`) menjaga partial unique index "satu instance LIVE per
/// (workspace, type)" di level DB (SQLite tidak dapat meng-indeks melalui
/// join). Diisi dan disinkronkan service lifecycle pada setiap penulisan;
/// nullable = kompatibilitas baris lama. Invariant sinkronisasi diuji test.
model ExtensionInstance {
  id            String    @id @default(cuid())
  workspaceId   String
  definitionId  String
  typeId        String? // Phase 5-D: denormalisasi definition.typeId (penjaga unique live-instance; disinkronkan service)
  status        String    @default("PURCHASED") // PURCHASED | ASSIGNED | ACTIVE | SUSPENDED | EXPIRED | RENEWED | REMOVED (LICENSE_MATRIX §5)
  quantity      Int? // mis. +10 seat untuk seat_package; satuan mengikuti ExtensionType (REQ-018)
  provisionedAt DateTime?
  termStartsAt  DateTime?
  termEndsAt    DateTime?
  sourceType    String? // referensi sumber perolehan (mis. "SHOP_ORDER") — tidak diisi di 5-B
  sourceRef     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict) // REQ-099: data operasional tidak ikut terhapus cascade
  definition ExtensionDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@index([workspaceId, status]) // agregasi entitlement efektif (DMC §3.6 access pattern)
  @@index([definitionId])
  @@index([typeId]) // Phase 5-D: pemeriksaan satu-live-instance per (workspace, type)
  @@index([status, termEndsAt]) // sweep renewal (5-C)
}

/// Definisi kuota per tier (DMC §3.5/§8) — HANYA nilai yang ditetapkan owner di
/// Master Control (miniRider = maks 5 kru per workspace, REQ-009/MC §2.1).
/// Tidak ada nilai kuota lain yang dikarang (OD-05/OD-06/OD-137 OPEN).
/// ownerCountedInQuota nullable = parameter eksplisit yang BELUM diputuskan
/// (OD-05) — keputusan owner cukup mengubah DATA, bukan schema (DMC §8).
/// Pembedaan konseptual: definition (tabel ini) vs grant (ExtensionInstance
/// quantity) vs usage/enforcement (runtime 5-C) — tidak ada field angka campur.
model TierQuota {
  id                  String   @id @default(cuid())
  tierId              String
  quotaCode           String // mis. "crew_seats_per_workspace"
  limitValue          Int
  unit                String // mis. "CREW_SEAT"
  ownerCountedInQuota Boolean? // null = OPEN (OD-05); bukan keputusan atas nama owner
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tier LicenseTier @relation(fields: [tierId], references: [id], onDelete: Restrict)

  @@unique([tierId, quotaCode])
  @@index([tierId, status])
}
